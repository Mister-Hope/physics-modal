{
  "name": "physics-explorer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "oxlint --fix --deny-warnings --report-unused-disable-directives && oxfmt",
    "lint:check": "oxlint --deny-warnings --report-unused-disable-directives && oxfmt --check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "vue": "3.5.35",
    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@mr-hope/tsconfig": "0.0.4",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "24.12.4",
    "@vitejs/plugin-vue": "6.0.7",
    "mathjax": "4.1.2",
    "oxc-config-hope": "0.3.6",
    "oxfmt": "0.52.0",
    "oxlint": "1.66.0",
    "oxlint-tsgolint": "0.23.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vite-plugin-static-copy": "4.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.5.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "error"
    }
  }
}
