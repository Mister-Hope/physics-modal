{
  "name": "physics-explorer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "conical-pendulum:build": "vite build conical-pendulum",
    "conical-pendulum:dev": "vite dev conical-pendulum",
    "conical-pendulum:preview": "vite preview --outDir conical-pendulum/dist",
    "build": "unrun scripts/build.ts",
    "lint": "oxlint --fix --deny-warnings --report-unused-disable-directives && oxfmt",
    "lint:check": "oxlint --deny-warnings --report-unused-disable-directives && oxfmt --check",
    "pendulum:build": "vite build pendulum",
    "pendulum:dev": "vite dev pendulum",
    "pendulum:preview": "vite preview --outDir pendulum/dist",
    "train-turn:build": "vite build train-turn",
    "train-turn:dev": "vite dev train-turn",
    "train-turn:preview": "vite preview --outDir train-turn/dist"
  },
  "dependencies": {
    "lucide-react": "1.14.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@mr-hope/tsconfig": "0.0.4",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "24.12.4",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "mathjax": "4.1.2",
    "oxc-config-hope": "0.3.5",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "oxlint-tsgolint": "0.23.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "unrun": "^0.3.0",
    "vite": "8.0.14",
    "vite-plugin-static-copy": "4.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.1.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "error"
    }
  }
}
