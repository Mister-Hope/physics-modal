{
  "name": "physics-explorer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.3",
    "@vueuse/core": "^15.0.0",
    "three": "^0.186.1",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@mr-hope/tsconfig": "0.0.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "6.0.10",
    "mathjax": "4.1.3",
    "oxc-config-hope": "0.3.15",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-static-copy": "4.1.1",
    "vue-tsc": "3.3.13"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.20.0",
      "onFail": "error"
    }
  }
}
